# Copia este archivo a .env (no se sube a git). Todos los valores son opcionales.
# Ruta al catálogo real de nodos (CSV: codigo,localidad,departamento,provincia,distrito)
FIELD_OPS_NODOS_CSV=config/nodos.csv
# Ruta al ejecutable de Tesseract si no está en el PATH (Windows)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Nombre del operador que queda en el log de acciones
FIELD_OPS_OPERADOR=operador-demo
# Remoto de rclone para subir la entrega (opcional), ej: drive:Entregas
FIELD_OPS_RCLONE_DESTINO=
